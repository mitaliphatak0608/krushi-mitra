{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Krushi Mitra Eligibility Rules (rule-engine-facing)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "scheme_id", "landholding", "region_topup", "category_share",
      "land_record_required", "crop_season", "special_conditions", "verify_needed"
    ],
    "properties": {
      "scheme_id": {"type": "string", "description": "Unique key, shared with schemes_content.json"},
      "landholding": {
        "type": "object",
        "required": ["min_ha", "max_ha", "bands"],
        "properties": {
          "min_ha": {"type": ["number", "null"]},
          "max_ha": {"type": ["number", "null"]},
          "bands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "band": {"type": "string"},
                "min_ha": {"type": "number"},
                "max_ha": {"type": "number"},
                "subsidy_pct": {"type": "number"}
              }
            }
          }
        }
      },
      "region_topup": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "regions": {"type": "array", "items": {"type": "string"}},
            "extra_pct": {"type": "number"}
          }
        }
      },
      "category_share": {
        "type": "object",
        "description": "Category -> subsidy/contribution percentage. null means not yet confirmed."
      },
      "land_record_required": {
        "type": "object",
        "required": ["required", "types", "conditions"],
        "properties": {
          "required": {"type": "boolean"},
          "types": {"type": "array", "items": {"type": "string"}},
          "conditions": {"type": "array", "items": {"type": "string"}}
        }
      },
      "crop_season": {"type": "array", "items": {"type": "string", "enum": ["Kharif", "Rabi"]}},
      "special_conditions": {"type": "array", "items": {"type": "string"}},
      "verify_needed": {
        "type": "array",
        "items": {"type": "string"},
        "description": "Notes on fields not yet confirmed against the live portal \u2014 must be empty before production use"
      }
    }
  }
}