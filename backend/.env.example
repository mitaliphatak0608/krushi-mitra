# Krushi Mitra — Backend Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed to version control.

# Admin access key — used to validate admin logins from the frontend.
# Choose a strong, random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
ADMIN_KEY=your-secret-admin-key-here

